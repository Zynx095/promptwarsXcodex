# FairShift environment configuration. Placeholders only — never commit real values.

# HTTP port. Cloud Run injects PORT automatically.
PORT=8080

# "production" enables secure cookies and requires SESSION_SECRET.
NODE_ENV=development

# Long random string used to sign session cookies, OAuth state tokens, OTP verification hashes,
# and confidential-report references.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# On Cloud Run, store it in Secret Manager and expose it as an environment variable.
SESSION_SECRET=replace-with-a-long-random-value

# SQLite database file. On Cloud Run the container filesystem is ephemeral (see docs/DEPLOYMENT.md).
DATABASE_PATH=./data/fairshift.db

# When "true", seeds the synthetic demonstration dataset into an empty database
# and enables the demo sign-in helper listing synthetic accounts.
# In production, set to "false".
DEMO_MODE=true

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (OIDC)
# ------------------------------------------------------------------------------
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
# (For local testing: http://localhost:8080/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ------------------------------------------------------------------------------
# GitHub OAuth (Optional SSO)
# ------------------------------------------------------------------------------
# Create in GitHub Developer Settings -> OAuth Apps -> New OAuth App.
# Authorization callback URL: https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ------------------------------------------------------------------------------
# SMS OTP Delivery Provider
# ------------------------------------------------------------------------------
# Options:
#   "none"   - Real SMS disabled; users see an informative unconfigured status.
#   "mock"   - Development/testing in-memory mock provider.
#   "twilio" - Production SMS delivery via Twilio API.
SMS_PROVIDER=none

# Twilio SMS credentials (required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# ------------------------------------------------------------------------------
# Passkeys (WebAuthn) for check-in and check-out
# ------------------------------------------------------------------------------
# The relying party ID is the site's domain without scheme or port, and the origins are the
# exact origins the app is served from (comma-separated). Required in production: without them
# passkeys stay off. In development they default to localhost.
# Example: WEBAUTHN_RP_ID=fairshift.example.org
#          WEBAUTHN_ORIGINS=https://fairshift.example.org
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# ------------------------------------------------------------------------------
# Optional providers (server-side keys; never sent to browsers)
# ------------------------------------------------------------------------------
# Google Cloud Text-to-Speech: server voice for read-aloud when a phone has no voice for the
# worker's language (en, kn, hi, ta, te, bn in India). Restrict the key to this API.
GOOGLE_TTS_API_KEY=
# Google Cloud Vision: advisory analysis of safety photos (labels and objects). Without it,
# every photo goes to manual review. Restrict the key to this API.
GOOGLE_VISION_API_KEY=
